+}
+
+/* Homepage paper grain and two-sided subtractive charcoal boundaries */
+.drawings-band.paper,
+.specialties.paper,
+.process.paper {
+  background-color: var(--paper);
+  background-image:
+    url("/sketchbook-paper.svg"),
+    radial-gradient(
+      ellipse at 14% 18%,
+      rgb(255 251 241 / 42%),
+      transparent 35%
+    ),
+    radial-gradient(ellipse at 82% 72%, rgb(105 84 55 / 5%), transparent 42%),
+    linear-gradient(103deg, rgb(89 70 44 / 2.5%), transparent 28% 76%);
+  background-repeat: no-repeat;
+  background-position: center, center, center, center;
+  background-size: cover, cover, cover, cover;
+  background-blend-mode: multiply, normal, multiply, multiply;
+}
+
+.about-band::before,
+.info-band::before,
+.consult::before {
+  content: "";
+  position: absolute;
+  z-index: 4;
+  top: -1px;
+  right: 0;
+  left: 0;
+  width: 100%;
+  height: calc(clamp(3rem, 6vw, 8.75rem) + 1px);
+  pointer-events: none;
+  background: var(--paper);
+  transform: scale(-1, -1);
+  transform-origin: center;
+  -webkit-mask: url("/charcoal-erosion-mask.svg") center / calc(100% + 1rem)
+    100% no-repeat;
+  mask: url("/charcoal-erosion-mask.svg") center / calc(100% + 1rem) 100%
+    no-repeat;
+}
+
+.info-band {
+  padding-bottom: clamp(3.75rem, 5vw, 5.25rem);
+}
+
+.consult {
+  padding-top: clamp(5rem, 6vw, 6.5rem);
+}
+
+.info-band::before {
+  transform: scaleY(-1);
+}
+
+.info-band::after {
+  transform: scaleX(-1);
+}
+
+.consult::before {
+  transform: scaleY(-1);
+  -webkit-mask-size: calc(100% + 7rem) 100%;
+  mask-size: calc(100% + 7rem) 100%;
+}
+
+@media (max-width: 600px) {
+  .about-band::before,
+  .info-band::before,
+  .consult::before {
+    height: calc(5rem + 1px);
+  }
+}
+
+/* Consultation request */
+.consultation-hero {
+  display: grid;
+  grid-template-columns: minmax(18rem, 1.05fr) minmax(18rem, 0.95fr);
+  gap: clamp(3rem, 9vw, 9rem);
+  align-items: end;
+  min-height: 30rem;
+  padding: clamp(6rem, 10vw, 9rem) clamp(1rem, 5vw, 5rem) clamp(4rem, 7vw, 6rem);
+  border-bottom: 1px solid #4b4133;
+  background:
+    radial-gradient(circle at 76% 42%, rgb(120 91 54 / 14%), transparent 26rem),
+    linear-gradient(115deg, #0a0a09, #171512 64%, #0b0b0a);
+}
+.consultation-hero h1 {
+  max-width: 10ch;
+  margin: 0;
+  font-size: clamp(3.8rem, 7.5vw, 7.25rem);
+  line-height: 0.9;
+}
+.consultation-hero-copy {
+  max-width: 34rem;
+  padding-bottom: 0.35rem;
+  color: #c8c0b4;
+  font-family: var(--serif);
+  font-size: clamp(1rem, 1.5vw, 1.2rem);
+  line-height: 1.75;
+}
+.consultation-hero-copy p:last-child {
+  margin-bottom: 0;
+  color: #928a7f;
+  font-family: var(--sans);
+  font-size: 0.75rem;
+  letter-spacing: 0.04em;
+}
+.consultation-paper {
+  position: relative;
+  padding: clamp(4rem, 7vw, 7rem) clamp(1rem, 5vw, 5rem)
+    clamp(6rem, 10vw, 10rem);
+  background:
+    radial-gradient(circle at 9% 12%, rgb(131 105 66 / 7%), transparent 25rem),
+    radial-gradient(circle at 86% 64%, rgb(91 72 45 / 4%), transparent 30rem),
+    linear-gradient(
+      102deg,
+      rgb(255 255 255 / 12%),
+      transparent 28% 72%,
+      rgb(75 57 34 / 3%)
+    ),
+    var(--paper);
+}
+.consultation-paper::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  opacity: 0.14;
+  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.55' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E");
+  mix-blend-mode: multiply;
+}
+.consultation-form,
+.consultation-confirmation {
+  position: relative;
+  z-index: 1;
+  max-width: 78rem;
+  margin-inline: auto;
+}
+.consultation-form-heading {
+  display: grid;
+  grid-template-columns: minmax(18rem, 1.1fr) minmax(16rem, 0.9fr);
+  gap: clamp(2rem, 7vw, 7rem);
+  align-items: end;
+  margin-bottom: clamp(3rem, 6vw, 5rem);
+  padding-bottom: clamp(2rem, 4vw, 3rem);
+  border-bottom: 1px solid #aa9d89;
+}
+.consultation-form-heading h2 {
+  max-width: 13ch;
+  margin: 0.4rem 0 0;
+  color: #181512;
+  font-size: clamp(2.5rem, 5vw, 4.8rem);
+  line-height: 0.98;
+}
+.consultation-form-heading > p {
+  max-width: 32rem;
+  margin: 0;
+  color: #5e574d;
+  font-family: var(--serif);
+  line-height: 1.75;
+}
+.consultation-form-message {
+  margin: 0 0 2rem;
+  padding: 1rem 1.1rem;
+  border-left: 2px solid #8d4339;
+  color: #662c25;
+  background: rgb(133 61 51 / 7%);
+  font-size: 0.86rem;
+}
+.consultation-fields {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 2rem clamp(1.5rem, 5vw, 4.5rem);
+}
+.consultation-field {
+  display: grid;
+  min-width: 0;
+  align-content: start;
+  gap: 0.55rem;
+  color: #27221c;
+  font-size: 0.75rem;
+  font-weight: 750;
+  letter-spacing: 0.07em;
+  text-transform: uppercase;
+}
+.consultation-field-wide {
+  grid-column: 1 / -1;
+}
+.consultation-field > span,
+.consultation-upload label > span {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+}
+.consultation-field b,
+.consultation-field em {
+  color: #766348;
+  font-size: 0.56rem;
+  font-style: normal;
+  font-weight: 750;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+.consultation-field em {
+  color: #7b7367;
+}
+.consultation-field small,
+.consultation-upload label small {
+  max-width: 48rem;
+  color: #6d655a;
+  font-family: var(--serif);
+  font-size: 0.82rem;
+  font-weight: 400;
+  letter-spacing: 0;
+  line-height: 1.55;
+  text-transform: none;
+}
+.consultation-field input,
+.consultation-field select,
+.consultation-field textarea {
+  width: 100%;
+  min-height: 3.3rem;
+  padding: 0.8rem 0.9rem;
+  border: 1px solid #9f927e;
+  border-radius: 0;
+  outline: none;
+  color: #1f1a15;
+  background: rgb(248 243 233 / 64%);
+  font: 400 1rem/1.45 var(--sans);
+  letter-spacing: normal;
+  text-transform: none;
+  transition:
+    border-color 150ms ease,
+    box-shadow 150ms ease,
+    background-color 150ms ease;
+}
+.consultation-field textarea {
+  min-height: 8rem;
+  resize: vertical;
+}
+.consultation-field input::placeholder,
+.consultation-field textarea::placeholder {
+  color: #857d72;
+  opacity: 1;
+}
+.consultation-field input:focus-visible,
+.consultation-field select:focus-visible,
+.consultation-field textarea:focus-visible {
+  border-color: #705933;
+  background: rgb(255 252 244 / 82%);
+  box-shadow: 0 0 0 3px rgb(137 108 63 / 18%);
+}
+.consultation-field input[aria-invalid="true"],
+.consultation-field select[aria-invalid="true"],
+.consultation-field textarea[aria-invalid="true"] {
+  border-color: #8d4339;
+}
+.consultation-field-error {
+  color: #7f322a;
+  font-size: 0.72rem;
+  font-weight: 650;
+  letter-spacing: 0;
+  text-transform: none;
+}
+.consultation-upload {
+  padding: clamp(1.25rem, 3vw, 2rem);
+  border: 1px solid #a99c87;
+  background: rgb(247 240 228 / 45%);
+}
+.consultation-upload > label {
+  display: grid;
+  gap: 0.55rem;
+}
+.consultation-upload input[type="file"] {
+  min-height: auto;
+  padding: 0.7rem;
+  color: #5c544a;
+  background: rgb(255 252 244 / 55%);
+  font-size: 0.78rem;
+}
+.consultation-upload input[type="file"]::file-selector-button {
+  min-height: 2.6rem;
+  margin-right: 0.9rem;
+  padding: 0.55rem 0.85rem;
+  border: 1px solid #7a684c;
+  color: #2a231a;
+  background: transparent;
+  font: 750 0.65rem var(--sans);
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+  cursor: pointer;
+}
+.consultation-previews {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
+  gap: 0.8rem;
+  margin-top: 0.6rem;
+}
+.consultation-previews.single {
+  grid-template-columns: minmax(8rem, 12rem);
+}
+.consultation-previews figure {
+  position: relative;
+  min-width: 0;
+  min-height: 10rem;
+  margin: 0;
+  overflow: hidden;
+  border: 1px solid #8d806d;
+  background: #d6cdbf;
+}
+.consultation-previews img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+.consultation-previews figcaption {
+  position: absolute;
+  inset: auto 0 0;
+  overflow: hidden;
+  padding: 1.8rem 0.55rem 0.45rem;
+  color: white;
+  background: linear-gradient(transparent, rgb(10 9 8 / 86%));
+  font-size: 0.58rem;
+  letter-spacing: 0.04em;
+  text-overflow: ellipsis;
+  text-transform: none;
+  white-space: nowrap;
+}
+.consultation-previews button {
+  position: absolute;
+  top: 0.4rem;
+  right: 0.4rem;
+  z-index: 1;
+  min-height: 2.75rem;
+  padding: 0.4rem 0.55rem;
+  border: 1px solid rgb(255 255 255 / 58%);
+  color: white;
+  background: rgb(12 11 10 / 82%);
+  font: 700 0.57rem var(--sans);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  cursor: pointer;
+}
+.consultation-honeypot {
+  position: absolute;
+  left: -10000px;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+}
+.consultation-submit-row {
+  display: flex;
+  align-items: center;
+  gap: 1.5rem;
+  margin-top: clamp(2.5rem, 5vw, 4rem);
+  padding-top: 2rem;
+  border-top: 1px solid #aa9d89;
+}
+.consultation-submit-row .button {
+  flex: 0 0 auto;
+}
+.consultation-submit-row p {
+  max-width: 34rem;
+  margin: 0;
+  color: #625a50;
+  font-family: var(--serif);
+  font-size: 0.82rem;
+}
+.consultation-confirmation {
+  max-width: 50rem;
+  padding: clamp(3rem, 7vw, 6rem);
+  border: 1px solid #9c8e78;
+  color: #27211a;
+  background: rgb(250 245 235 / 62%);
+}
+.consultation-confirmation h2 {
+  max-width: 14ch;
+  margin: 0.6rem 0 1.25rem;
+  font-size: clamp(2.5rem, 5vw, 4.5rem);
+}
+.consultation-confirmation > p:last-child {
+  max-width: 38rem;
+  color: #60584d;
+  font-family: var(--serif);
+  line-height: 1.75;
+}
+
+@media (max-width: 760px) {
+  .consultation-hero,
+  .consultation-form-heading,
+  .consultation-fields {
+    grid-template-columns: 1fr;
+  }
+  .consultation-hero {
+    min-height: auto;
+    gap: 2rem;
+    padding: 4rem 1rem;
+  }
+  .consultation-hero h1 {
+    font-size: clamp(3.4rem, 16vw, 5rem);
+  }
+  .consultation-paper {
+    padding: 3.5rem 1rem 5rem;
+  }
+  .consultation-form-heading {
+    gap: 1.5rem;
+    margin-bottom: 2.5rem;
+  }
+  .consultation-field-wide {
+    grid-column: auto;
+  }
+  .consultation-submit-row {
+    align-items: stretch;
+    flex-direction: column;
+  }
+  .consultation-submit-row .button {
+    width: 100%;
+    min-height: 3.25rem;
+  }
+}
+
+@media (max-width: 420px) {
+  .consultation-previews {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .consultation-upload {
+    padding: 1rem;
+  }
+  .consultation-upload input[type="file"]::file-selector-button {
+    display: block;
+    width: 100%;
+    margin: 0 0 0.65rem;
+  }
+}
+
+/* Four-slot hero and focused portfolio administration */
+.hero-artworks {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+.hero-artworks[data-count="3"] {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+.hero-artworks[data-count="2"] {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  max-width: 35rem;
+}
+.hero-artworks[data-count="1"] {
+  grid-template-columns: minmax(12rem, 17rem);
+}
+.hero-without-artworks {
+  grid-template-columns: minmax(0, 34rem);
+}
+
+.admin-intro {
+  max-width: 42rem;
+  color: #5f594f;
+  font-family: var(--serif);
+}
+.bulk-upload-form {
+  display: grid;
+  gap: 1.5rem;
+  margin-top: 2.5rem;
+}
+.bulk-upload-controls {
+  display: grid;
+  grid-template-columns: minmax(12rem, 0.45fr) minmax(18rem, 1.55fr);
+  gap: 1.25rem;
+  max-width: 58rem;
+}
+.bulk-upload-controls label,
+.bulk-preview-fields label,
+.placement-form label {
+  display: grid;
+  gap: 0.45rem;
+  font-weight: 700;
+}
+.bulk-upload-controls label > span {
+  color: #6d675e;
+  font-size: 0.82rem;
+  font-weight: 400;
+}
+.bulk-upload-controls input,
+.bulk-upload-controls select,
+.bulk-preview-fields input,
+.placement-form select {
+  width: 100%;
+  min-height: 3rem;
+  padding: 0.75rem;
+  border: 1px solid #bcb3a5;
+  border-radius: 0;
+  background: #fff;
+  font: inherit;
+}
+.bulk-upload-summary {
+  margin: 0;
+  color: #625b51;
+  font-size: 0.82rem;
+}
+.bulk-preview-list {
