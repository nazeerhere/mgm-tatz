+  color: #625b51;
+  font-family: var(--serif);
+  font-size: 0.9rem;
+}
+.faq-list {
+  border-top: 1px solid #a99d8b;
+}
+.faq-list details {
+  border-bottom: 1px solid #a99d8b;
