+  color: #ede4d6;
+  background: #0c0c0b;
+}
+
+.consultation-sidebar {
+  position: relative;
+  min-width: 0;
+  overflow: hidden;
+  padding: clamp(3rem, 5vw, 5.5rem) clamp(2rem, 4vw, 4.5rem)
+    clamp(24rem, 32vw, 36rem);
+  border-right: 0;
+  color: #2a251f;
+  background-color: var(--consultation-paper);
+  background-image:
+    radial-gradient(
+      ellipse at 18% 10%,
+      rgb(247 234 207 / 16%),
+      transparent 35%
+    ),
+    radial-gradient(ellipse at 86% 54%, rgb(83 61 39 / 12%), transparent 44%),
