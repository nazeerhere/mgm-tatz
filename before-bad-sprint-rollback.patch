+.bulk-preview-image img {
+  object-fit: contain;
+}
+.bulk-preview-fields {
+  display: grid;
+  gap: 0.9rem;
+}
+.bulk-filename {
+  margin: 0;
+  color: #6d675e;
+  font-size: 0.72rem;
