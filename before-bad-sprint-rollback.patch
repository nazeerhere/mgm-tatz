+    min-height: 3rem;
+  }
+  .footer-navs {
+    grid-template-columns: 1fr;
+    gap: 1.25rem;
+  }
+  .site-footer .footer-navs nav {
+    gap: 0;
+    padding-bottom: 1.25rem;
+    border-bottom: 1px solid var(--line);
+  }
+  .site-footer .footer-navs nav:last-child {
+    padding-bottom: 0;
+    border-bottom: 0;
+  }
+  .site-footer .footer-navs h2 {
+    margin-bottom: 0.45rem;
