+}
+.bulk-file-state {
+  margin: 0;
+  font-size: 0.75rem;
+}
+.bulk-file-state.uploading {
+  color: #71572d;
+}
+.bulk-file-state.success {
+  color: #356047;
+}
+.bulk-file-state.error {
+  color: #8a3e32;
+}
+.bulk-remove {
+  min-height: 2.75rem;
+}
+.bulk-upload-form > .button {
+  margin-top: 0.5rem;
+}
+.bulk-upload-note {
