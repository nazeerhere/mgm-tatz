+  flex-wrap: wrap;
+  gap: 0.75rem 1.75rem;
+  margin: 1rem 0;
+}
+.surface-statuses div {
+  display: grid;
+  gap: 0.1rem;
+}
+.surface-statuses dt {
+  color: #71695e;
