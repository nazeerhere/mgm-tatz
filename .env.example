NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional public footer contact destinations. Leave blank until approved.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only. Used only by the validated public consultation action.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mailchimp Marketing API (server-only; never prefix these with NEXT_PUBLIC_).
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=your-mailchimp-audience-id

# The authenticated Supabase user's UUID. Only this user may administer content.
OWNER_USER_ID=00000000-0000-0000-0000-000000000000
